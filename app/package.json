{
  "name": "simply-note-tauri",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "tauri-win": "node ../frontend/node_modules/@tauri-apps/cli/tauri.js",
    "tauri": "../frontend/node_modules/.bin/tauri",
    "dev": "npm run tauri -- dev",
    "run": "npm run dev",
    "build": "npm run tauri -- build",
    "android:init": "npm run tauri -- android init",
    "android:dev": "npm run tauri -- android dev",
    "android:run": "npm run android:dev",
    "android:run:device": "npm run tauri -- android dev",
    "android:build": "npm run tauri -- android build",
    "android:devices": "adb devices -l",
    "ios:init": "npm run tauri -- ios init",
    "ios:dev": "npm run tauri -- ios dev",
    "ios:run": "npm run ios:dev",
    "ios:run:device": "npm run tauri -- ios dev",
    "ios:build": "npm run tauri -- ios build",
    "ios:build:simulator": "npm run tauri -- ios build --target aarch64-sim",
    "ios:build:device": "npm run tauri -- ios build --target aarch64",
    "ios:devices": "xcrun xctrace list devices"
  }
}
